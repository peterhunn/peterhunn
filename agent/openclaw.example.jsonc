// OpenClaw provider configuration for a fully-local Mac setup.
//
// Copy to:  ~/Library/Application Support/openclaw/config.jsonc
// Then:     openclaw doctor --fix     (validates + rewrites into canonical form)
//
// This pins the local Ollama daemon as the sole model provider so the agent
// never phones out to a cloud endpoint. `apiKey: "ollama-local"` is
// OpenClaw's marker for loopback/LAN hosts and is not a real credential.
{
  "models": {
    "default": "qwen2.5-coder:7b",
    "providers": {
      "ollama": {
        "api": "ollama",
        "baseUrl": "http://127.0.0.1:11434",
        "apiKey": "ollama-local",
        "models": [
          "qwen2.5-coder:7b"
          // Add more tags here after `ollama pull <tag>`.
          // "qwen2.5-coder:14b",
          // "gemma3:12b",
          // "deepseek-r1:14b"
        ]
      }
    }
  },
  "memory": {
    "search": {
      // Reuse the same Ollama host for embeddings — no external calls.
      "provider": "ollama"
    }
  }
}
