# Copy to .env and fill in the providers you want to use.
# Anything left blank falls back to the mock provider (with a visible
# reason on the response so nothing is silent).

# ─── First-party APIs ───────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional: point the OpenAI adapter at an OpenAI-compatible endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# ─── OpenAI-compatible providers ────────────────────────────────
# Convention: model rows in the registry carry provider =
# "openai_compatible:<slug>"; each slug reads
# ATELIER_LLM_<SLUG>_URL and ATELIER_LLM_<SLUG>_KEY.

# Ollama (local, no key)
# ATELIER_LLM_OLLAMA_URL=http://localhost:11434/v1/chat/completions

# Together AI
# ATELIER_LLM_TOGETHER_URL=https://api.together.xyz/v1/chat/completions
# ATELIER_LLM_TOGETHER_KEY=

# Groq
# ATELIER_LLM_GROQ_URL=https://api.groq.com/openai/v1/chat/completions
# ATELIER_LLM_GROQ_KEY=

# Fireworks
# ATELIER_LLM_FIREWORKS_URL=https://api.fireworks.ai/inference/v1/chat/completions
# ATELIER_LLM_FIREWORKS_KEY=

# vLLM (self-hosted OpenAI-compatible)
# ATELIER_LLM_VLLM_URL=http://localhost:8000/v1/chat/completions

# ─── Google OAuth (Calendar + Gmail consent flow) ──────────────
# Create an OAuth 2.0 client in Google Cloud Console. Register
# GOOGLE_OAUTH_REDIRECT_URI (below) as an authorized redirect URI.
# ATELIER_OAUTH_STATE_SECRET signs the state parameter; must be
# >=16 chars and rotated on suspected exposure.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/oauth/google/callback
# ATELIER_OAUTH_STATE_SECRET=please-set-a-32-plus-char-secret
# ATELIER_CONSOLE_URL=http://localhost:3000

# ─── Web tools (Research agent) ─────────────────────────────────
# Pick one search provider; the adapter tries Tavily → Serper → Brave
# → mock. Add a JINA_API_KEY only if you need higher fetch rate limits.
# TAVILY_API_KEY=
# SERPER_API_KEY=
# BRAVE_SEARCH_API_KEY=
# JINA_API_KEY=
# ATELIER_DISABLE_JINA=1   # skip Jina Reader and use raw fetch only

# ─── Background sync scheduler ─────────────────────────────────
# The API boots a scheduler that walks every household with a
# stored gmail credential and runs the incremental Gmail sync on
# an interval. Set ATELIER_SYNC_ENABLED=0 to turn it off (for
# tests or one-shot workers). Interval is in seconds, floored to 5s.
# ATELIER_SYNC_INTERVAL_SECONDS=300
# ATELIER_SYNC_ENABLED=1
# When the scheduler is on, each fresh Gmail/Calendar item can be
# handed to the autopilot, which dispatches the matching agent so
# proposed actions land in the approval queue automatically.
# Per-household on/off lives in the households table; this is the
# global kill switch. ATELIER_AUTOPILOT_ENABLED=0 disables.
# ATELIER_AUTOPILOT_ENABLED=1
# Playbook runner (packaged autonomy templates) — fires alongside
# the sync tick for any enabled household_playbook whose
# next_fire_at has passed. Global kill switch:
# ATELIER_PLAYBOOKS_ENABLED=0

# ─── Customer messaging (Twilio SMS / WhatsApp) ────────────────
# Set the account auth token so /messaging/inbound/twilio verifies
# webhook signatures. If unset the webhook accepts without
# verification (dev mode) and logs a one-line notice.
# ATELIER_TWILIO_AUTH_TOKEN=
# Outbound Twilio credentials are stored per-household in the
# credentials table (provider="twilio", kind="api_key"). Shape:
#   { account_sid, auth_token, from_number?, messaging_service_sid? }
# messaging_service_sid takes precedence when set (Twilio picks the
# From automatically). Without a stored credential, sends fall back
# to a mock provider with a visible reason.

# ─── Local dev ──────────────────────────────────────────────────
# ATELIER_DB_URL=./packages/db/data/atelier.db
# PORT=3001
# LOG_LEVEL=info
