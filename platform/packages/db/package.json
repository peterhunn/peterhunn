{
  "name": "@atelier/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "migrate:generate": "drizzle-kit generate",
    "migrate:apply": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@atelier/domain": "workspace:*",
    "@aws-sdk/client-s3": "^3.700.0",
    "better-sqlite3": "^11.3.0",
    "drizzle-orm": "^0.36.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "drizzle-kit": "^0.28.0",
    "@vitest/coverage-v8": "^2.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
