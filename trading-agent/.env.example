ANTHROPIC_API_KEY=sk-ant-...

# One env var per endpoint declared in endpoints.yaml. The name matches
# that endpoint's `token_env` field.
ROBINHOOD_MCP_TOKEN=
LINEAR_MCP_TOKEN=

# Global run settings.
DRY_RUN=true
MODEL=claude-opus-4-8
EFFORT=high

# Per-endpoint limits (write count, notional caps, prompt path, journal
# path) all live in endpoints.yaml — not here.
