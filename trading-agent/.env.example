ANTHROPIC_API_KEY=sk-ant-...

# One env var per endpoint declared in endpoints.yaml. HTTP endpoints
# read from their `token_env` field; stdio endpoints inherit env into
# the subprocess (so put anything the MCP subprocess needs here too).
ROBINHOOD_MCP_TOKEN=
LINEAR_MCP_TOKEN=
MANIFOLD_API_KEY=

# Kalshi (stdio MCP — see endpoints.yaml). Generate from your Kalshi
# account settings; the private key never leaves your machine.
# KALSHI_API_KEY=
# KALSHI_PRIVATE_KEY_PATH=/absolute/path/to/kalshi-private-key.pem

# Global run settings.
DRY_RUN=true
MODEL=claude-opus-4-8
EFFORT=high

# Per-endpoint limits (write count, notional caps, prompt path, journal
# path) all live in endpoints.yaml — not here.
